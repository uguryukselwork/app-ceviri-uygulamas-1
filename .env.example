# Copy to .env.local for local development, and add the same two values in
# Vercel > Project > Settings > Environment Variables.
# Supabase > Project Settings > API: "Project URL" and the "publishable" key.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# GEMINI_API_KEY is NOT set here. Translation runs in the Supabase edge function
# "translate"; set the key in Supabase > Edge Functions > Secrets.
