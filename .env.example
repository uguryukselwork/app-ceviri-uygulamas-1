# Optional: the app falls back to the LiveTranslate project defaults in src/lib/supabase.ts.
# Set these (in .env.local or
# Vercel > Project > Settings > Environment Variables) only to point at another project.
# Supabase > Project Settings > API: "Project URL" and the "publishable" key.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# GEMINI_API_KEY is NOT set here. Translation runs in the Supabase edge function
# "translate"; set the key in Supabase > Edge Functions > Secrets.
